@page
@model LoginModel

@{
    // ViewData["Title"] = "Log in";
    ViewData["BodyClass"] = "login-body";

}

@* < h1>@ViewData["Title"]</h1>  *@



<div class="container-fluid login-container d-flex align-items-center">
    <div class="row flex-grow-1">
        <!-- Left Side with your image -->
        <div class="col-md-6 d-none d-md-block login-left">
            <!-- Optional logo or overlay here -->
        </div>

        <!-- Right Side Login Form -->
        <div class="col-md-6 login-form-wrapper d-flex align-items-center">
            <div class="login-form w-100">
                <h3 class="text-center mb-4">Welcome to NextGen Bank</h3>

                <form method="post" id="account">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

                    <div class="form-floating mb-3">
                        <input asp-for="Input.Email" class="form-control" placeholder="Email" autocomplete="username" aria-required="true" />
                        <label asp-for="Input.Email">Email</label>
                        <span asp-validation-for="Input.Email" class="text-danger"></span>
                    </div>

                    <div class="form-floating mb-3">
                        <input asp-for="Input.Password" class="form-control" placeholder="Password" autocomplete="current-password" aria-required="true" />
                        <label asp-for="Input.Password">Password</label>
                        <span asp-validation-for="Input.Password" class="text-danger"></span>
                    </div>

                    <div class="form-check mb-3">
                        <input class="form-check-input" asp-for="Input.RememberMe" />
                        <label class="form-check-label" asp-for="Input.RememberMe">
                            @Html.DisplayNameFor(m => m.Input.RememberMe)
                        </label>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 mb-3" style="background-color: #76A5AF;">
                        <i class="bi bi-box-arrow-in-right me-1"></i> Log in
                    </button>

                    <div class="login-links text-center">
                        <a asp-page="./ForgotPassword">Forgot password?</a><br />
                        <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Create an account</a><br />
                        <a asp-page="./ResendEmailConfirmation">Resend email confirmation</a>
                    </div>
                </form>

                @if ((Model.ExternalLogins?.Count ?? 0) > 0)
                {
                        <div class="mt-4">
                            <hr />
                            <p class="text-center">Or log in with:</p>
                            <form asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                            @foreach (var provider in Model.ExternalLogins!)
                            {
                                        <button type="submit" class="btn btn-outline-dark w-100 mb-2"
                                                name="provider" value="@provider.Name">
                                            <i class="bi bi-box-arrow-in-right me-1"></i> Log in with @provider.DisplayName
                                        </button>
                            }
                            </form>
                        </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
