@page "{id}"
@model EditUserModel
@{
    ViewData["Title"] = "Edit User";
}

<h2>Edit User</h2>
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow p-4">
                <h4 class="text-center mb-4 text-primary">Edit User</h4>

                <form method="post">
                    <input type="hidden" asp-for="Input.Id" />

                    <div class="mb-3">
                        <label asp-for="Input.Email" class="form-label">Email</label>
                        <input asp-for="Input.Email" class="form-control" />
                        <span asp-validation-for="Input.Email" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.SelectedRole" class="form-label">Role</label>
                        <select asp-for="Input.SelectedRole" class="form-select">
                            @foreach (var role in Model.AllRoles)
                            {
                                <option value="@role">@role</option>
                            }
                        </select>
                        <span asp-validation-for="Input.SelectedRole" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.NewPassword" class="form-label"></label>
                        <input asp-for="Input.NewPassword" class="form-control" />
                        <span asp-validation-for="Input.NewPassword" class="text-danger"></span>
                    </div>



                    <button type="submit" class="btn btn-primary">Save</button>
                    <a asp-page="./ManageUsers" class="btn btn-secondary">Cancel</a>
                </form>

            </div>
        </div>
    </div>
</div>

