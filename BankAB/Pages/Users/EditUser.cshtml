@page "{id}"
@model EditUserModel
@{
    ViewData["Title"] = "Edit User";
}

<h2>Edit User</h2>

<form method="post">
    <div class="mb-3">
        <label class="form-label">Email</label>
        <input class="form-control" value="@Model.User.Email" readonly />
    </div>
    <div class="mb-3">
        <label class="form-label">Role</label>
        <select class="form-select" asp-for="SelectedRole">
            @foreach (var role in Model.AllRoles)
            {
                <option value="@role" selected="@(role == Model.SelectedRole)">
                    @role
                </option>
            }
        </select>
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-page="./ManageUsers" class="btn btn-secondary">Cancel</a>
</form>
