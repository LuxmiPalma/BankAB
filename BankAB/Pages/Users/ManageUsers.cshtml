@page
@model ManageUsersModel
@using Microsoft.AspNetCore.Identity
@inject UserManager<IdentityUser> UserManager
@inject RoleManager<IdentityRole> RoleManager

@{
    ViewData["Title"] = "Manage Users";
    // List of protected accounts (cannot be deleted)
    var protectedEmails = new List<string>
    {
       "richard.chalk@admin.se",
       "richard.chalk@cashier.se",
    };
}

<h2 class="text-center">Manage Users</h2>

<a asp-area="Identity" asp-page="/Account/Register" class="btn btn-success mb-3">
    <i class="bi bi-person-plus"></i> Create New User
</a>

<table class="table table-bordered table-hover">
    <thead>
        <tr>
            <th>Email</th>
            <th>Roles</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model.Users)
        {
            <tr>
                <td>@user.Email</td>
                <td>@string.Join(", ", await UserManager.GetRolesAsync(user))</td>
                <td>
                    <a asp-page="./EditUser" asp-route-id="@user.Id" class="btn btn-sm btn-outline-primary me-2">Edit</a>

                    @if (!protectedEmails.Contains(user.Email, StringComparer.OrdinalIgnoreCase))
                    {
                        <a asp-page="./DeleteUser" asp-route-id="@user.Id" class="btn btn-sm btn-danger">Delete</a>
                    }
                    else
                    {
                        <span class="btn btn-sm btn-info">Protected</span>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
