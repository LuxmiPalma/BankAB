@page
@model BankAB.Pages.Customers.CustomersModel
@{
    var q = ViewContext.HttpContext.Request.Query["q"];
}

<body style="background-color: #f0f4f8;">
    <div class="container my-5 d-flex justify-content-center">
        <div class="p-4 rounded-4 shadow-lg bg-white w-100" style="max-width: 1000px;">

            <h2 class="text-center mb-4">All Customers</h2>

            <!-- 🔍 Search & ➕ Create Row -->
            <div class="d-flex justify-content-between align-items-center mb-3">
                <form method="get" class="d-flex">
                    <input type="text" name="q" value="@q" class="form-control me-2" placeholder="Search name, city or country..." />
                    <button class="btn btn-sm btn-primary hover-gray" type="submit">Search</button>
                </form>
                <a href="@Url.Page("/CustomerEntry/Create")" class="btn btn-sm btn-primary btn-grad">
                    <i class="fa fa-plus"></i> Create New Customer
                </a>
            </div>

            <!-- 👇 Table -->
            <table class="table table-striped align-middle table-hover">
                <thead class="table-light">
                    <tr>
                        <th scope="col">
                            Id
                            <a asp-page="/Customers/Customers" asp-route-sortColumn="Id" asp-route-sortOrder="asc" asp-route-q="@q"><i class="fa-solid fa-angle-up"></i></a>
                            <a asp-page="/Customers/Customers" asp-route-sortColumn="Id" asp-route-sortOrder="desc" asp-route-q="@q"><i class="fa-solid fa-angle-down"></i></a>
                        </th>
                        <th scope="col">
                            Surname
                            <a asp-page="/Customers/Customers" asp-route-sortColumn="Surname" asp-route-sortOrder="asc" asp-route-q="@q"><i class="fa-solid fa-angle-up"></i></a>
                            <a asp-page="/Customers/Customers" asp-route-sortColumn="Surname" asp-route-sortOrder="desc" asp-route-q="@q"><i class="fa-solid fa-angle-down"></i></a>
                        </th>
                        <th scope="col">
                            City
                            <a asp-page="/Customers/Customers" asp-route-sortColumn="City" asp-route-sortOrder="asc" asp-route-q="@q"><i class="fa-solid fa-angle-up"></i></a>
                            <a asp-page="/Customers/Customers" asp-route-sortColumn="City" asp-route-sortOrder="desc" asp-route-q="@q"><i class="fa-solid fa-angle-down"></i></a>
                        </th>
                        <th scope="col">
                            Country
                            <a asp-page="/Customers/Customers" asp-route-sortColumn="Country" asp-route-sortOrder="asc" asp-route-q="@q"><i class="fa-solid fa-angle-up"></i></a>
                            <a asp-page="/Customers/Customers" asp-route-sortColumn="Country" asp-route-sortOrder="desc" asp-route-q="@q"><i class="fa-solid fa-angle-down"></i></a>
                        </th>
                        <th scope="col"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var cus in Model.Customers)
                    {
                        <tr>
                            <td>@cus.Id</td>
                            <td>@cus.Name</td>
                            <td>@cus.City</td>
                            <td>@cus.Country</td>
                            <td>
                                <a asp-page="/Customers/Customer" asp-route-id="@cus.Id" class="btn btn-sm btn-primary">View</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

        </div>
    </div>
</body>
