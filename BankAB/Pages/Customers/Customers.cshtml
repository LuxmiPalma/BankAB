@page
@model BankAB.Pages.Customers.CustomersModel
@{

}

<body style="background-color: #f0f4f8;">
    <div class="container my-5 d-flex justify-content-center">
        <div class="p-4 rounded-4 shadow-lg bg-white w-100" style="max-width: 1000px;">

            <h2 style="font-size: 2.5rem; font-weight: 700;" class="text-center mb-4">All Customers</h2>

            <!-- 🔍 Search & ➕ Create Row -->
            <div class="d-flex justify-content-between align-items-center mb-3">
                <form method="get" class="d-flex">
                    <input type="text" name="q" value="@Model.Q" class="form-control me-2" placeholder="Search name, city or country..." />
                    <button class="btn btn-sm btn-primary hover-gray" type="submit">Search</button>
                </form>
                <a href="@Url.Page("/CustomerEntry/Create")" class="btn btn-sm btn-primary btn-grad">
                    <i class="fa fa-plus"></i> Create New Customer
                </a>
            </div>

            <!-- 👇 Table -->
            <table class="table table-striped align-middle table-hover">
                <thead class="table-light">
                    <tr>
                        <th scope="col">
                            Id
                            <a asp-page="/Customers/Customers" asp-route-sortColumn="CustomerId" asp-route-sortOrder="asc" asp-route-q="@Model.Q"><i class="fa-solid fa-angle-up"></i></a>
                            <a asp-page="/Customers/Customers" asp-route-sortColumn="CustomerId" asp-route-sortOrder="desc" asp-route-q="@Model.Q"><i class="fa-solid fa-angle-down"></i></a>
                        </th>
                        <th scope="col">
                            Surname
                            <a asp-page="/Customers/Customers" asp-route-sortColumn="Surname" asp-route-sortOrder="asc" asp-route-q="@Model.Q"><i class="fa-solid fa-angle-up"></i></a>
                            <a asp-page="/Customers/Customers" asp-route-sortColumn="Surname" asp-route-sortOrder="desc" asp-route-q="@Model.Q"><i class="fa-solid fa-angle-down"></i></a>
                        </th>
                        <th scope="col">
                            City
                            <a asp-page="/Customers/Customers" asp-route-sortColumn="City" asp-route-sortOrder="asc" asp-route-q="@Model.Q"><i class="fa-solid fa-angle-up"></i></a>
                            <a asp-page="/Customers/Customers" asp-route-sortColumn="City" asp-route-sortOrder="desc" asp-route-q="@Model.Q"><i class="fa-solid fa-angle-down"></i></a>
                        </th>
                        <th scope="col">
                            Country
                            <a asp-page="/Customers/Customers" asp-route-sortColumn="Country" asp-route-sortOrder="asc" asp-route-q="@Model.Q"><i class="fa-solid fa-angle-up"></i></a>
                            <a asp-page="/Customers/Customers" asp-route-sortColumn="Country" asp-route-sortOrder="desc" asp-route-q="@Model.Q"><i class="fa-solid fa-angle-down"></i></a>
                        </th>
                        <th scope="col"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model.PagedCustomers.Results)
                    {
                        <tr>
                            <td>@c.CustomerId</td>
                            <td>@c.Givenname @c.Surname</td>
                            <td>@c.City</td>
                            <td>@c.Country</td>
                            <td>
                                <a asp-page="/Customers/Customer" asp-route-id="@c.CustomerId" class="btn btn-sm btn-primary">View</a>
                            </td>
                        </tr>
                    }
                    

                    
                </tbody>
            </table>
            <nav aria-label="Customer pagination">
                <ul class="pagination justify-content-center mt-4">
                    @if (Model.PagedCustomers.CurrentPage > 1)
                    {
                        <li class="page-item">
                            <a class="page-link"
                               asp-route-pageNo="@(Model.PagedCustomers.CurrentPage - 1)"
                               asp-route-sortColumn="@Model.SortColumn"
                               asp-route-sortOrder="@Model.SortOrder"
                               asp-route-q="@Model.Q">«</a>
                        </li>
                    }

                    @{
                        int start = Math.Max(1, Model.PagedCustomers.CurrentPage - 2);
                        int end = Math.Min(Model.PagedCustomers.PageCount, Model.PagedCustomers.CurrentPage + 2);
                    }

                    @for (int i = start; i <= end; i++)
                    {
                        <li class="page-item @(i == Model.PagedCustomers.CurrentPage ? "active" : "")">
                            <a class="page-link"
                               asp-route-pageNo="@i"
                               asp-route-sortColumn="@Model.SortColumn"
                               asp-route-sortOrder="@Model.SortOrder"
                               asp-route-q="@Model.Q">@i</a>
                        </li>
                    }

                    @if (Model.PagedCustomers.CurrentPage < Model.PagedCustomers.PageCount)
                    {
                        <li class="page-item">
                            <a class="page-link"
                               asp-route-pageNo="@(Model.PagedCustomers.CurrentPage + 1)"
                               asp-route-sortColumn="@Model.SortColumn"
                               asp-route-sortOrder="@Model.SortOrder"
                               asp-route-q="@Model.Q">»</a>
                        </li>
                    }
                </ul>
            </nav>


        </div>
    </div>
</body>
