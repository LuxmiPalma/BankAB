@page
@model BankAB.Pages.AboutUsModel
@{
}
<section id="about" class="about section">

    <div class="container" data-aos="fade-up">
        <div class="row gx-0">

            <div class="col-lg-6 d-flex flex-column justify-content-center" data-aos="fade-up" data-aos-delay="200">
                <div class="content">
                    <h3>Who I Am</h3>
                    <h2>A Passion for Building Smart Banking Solutions</h2>
                    <p>
                        Hi! I'm a dedicated developer and the creator of NextGen Bank. I built this platform as part of my journey to become a full-stack .NET developer, with the goal of making online banking easier, safer, and more user-friendly for everyone.
                    </p>
                    <p>
                        This project combines my skills in web development, databases, and secure systems. I’m constantly learning and improving, and I hope this app reflects my passion for quality code, clean design, and real-world problem solving.
                    </p>
                    <div class="text-center text-lg-start">
                        <a asp-area="Identity" asp-page="/Account/Login" class="btn-read-more d-inline-flex align-items-center justify-content-center align-self-center">
                            <span>Login to Explore</span>
                            <i class="bi bi-arrow-right"></i>
                        </a>
                        <a class="btn-read-more d-inline-flex align-items-center justify-content-center align-self-center ms-3" href="https://github.com/LuxmiPalma" target="_blank">
                            <span>GitHub</span>
                            <i class="bi bi-github"></i>
                        </a>
                    </div>
                </div>
            </div>

            <div class="col-lg-6 d-flex align-items-center" data-aos="zoom-out" data-aos-delay="200">
                <img src="assets/img/about.jpg" class="img-fluid" alt="">
            </div>

        </div>
    </div>

</section><!-- /About Section -->
