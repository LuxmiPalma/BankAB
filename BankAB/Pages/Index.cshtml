<section id="hero" class="hero d-flex align-items-center">
    <div class="container">
        <div class="row">
            <div class="col-lg-6 d-flex flex-column justify-content-center">
                <h1>Welcome to NextGen Bank</h1>
                <h2>Your secure digital banking solution</h2>
                <div>
                    <a href="/Identity/Account/Login" class="btn-get-started scrollto d-inline-flex align-items-center justify-content-center align-self-center">
                        <span>Get Started</span>
                        <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            </div>
            @* <div class="col-lg-6 hero-img" >
                <img src="~/assets/img/hero-img.png" class="img-fluid" alt="Hero Image" />
            </div> *@
        </div>
       
    </div>


</section>
<!-- Services Section -->
<section id="services" class="services section">

    <!-- Section Title -->
    <div class="container section-title" data-aos="fade-up">
        <h2 style ="color: #0ea5e9; font-weight: 600;">Bank Statistics by Country</h2>
        <p>Financial & Banking Statistics<br></p>
    </div><!-- End Section Title -->

    <div class="container">

        <div class="row gy-4">
            @foreach (var item in Model.DataPerCountry)
            {

                <div class="col-lg-4 col-md-6" data-aos="fade-up" data-aos-delay="100">
                    <div class="service-item item-cyan position-relative">
                        <img src="@($"https://flagcdn.com/24x18/{GetCountryCode(item.Key)}.png")"
                             alt="@item.Key Flag"
                             class="mb-2"
                             style="width: 24px; height: 18px;" />                        <h3>@item.Key</h3>
                        <p>
                            <strong>Customers:</strong> @item.Value.customers <br />
                            <strong>Accounts:</strong> @item.Value.accounts <br />
                            <strong>Balance:</strong> SEK @item.Value.totalBalance.ToString("N1")M
                        </p>
                        <a asp-page="/CountryDetails" asp-route-country="@item.Key" class="read-more stretched-link">
                            <span>View Details</span> <i class="bi bi-arrow-right"></i>
                        </a>
                    </div>
            </div><!-- End Service Item -->
            }

           

            

           

        </div>

    </div>

</section><!-- /Services Section -->
<!-- About Section -->
<section id="about" class="about section">

    <div class="container" data-aos="fade-up">
        <div class="row gx-0">

            <div class="col-lg-6 d-flex flex-column justify-content-center" data-aos="fade-up" data-aos-delay="200">
