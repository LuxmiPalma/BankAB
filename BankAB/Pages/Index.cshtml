                    <p>
                        Check out the about page to learn more!

                        
                    </p>
                    <div class="text-center text-lg-start mt-3">
                        <a asp-page="/AboutUs" class="btn btn-sm btn-primary btn-grad d-inline-flex align-items-center justify-content-center align-self-center px-4 py-2">
                            <span>ABOUT PAGE</span>
