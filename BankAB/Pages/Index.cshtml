@page
@model BankAB.Pages.IndexModel
@{
    ViewData["Title"] = "Home page";
}
@functions {
    string GetCountryCode(string countryName)
    {
        return countryName.ToLower() switch
        {
            "sweden" => "se",
            "norway" => "no",
            "denmark" => "dk",
            "finland" => "fi",
            "iceland" => "is",
            _ => "un" // 'un' for unknown
        };
    }
}

