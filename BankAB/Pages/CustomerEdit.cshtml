@page "{id:int}"
@model BankAB.Pages.CustomerEditModel
@{
    ViewData["Title"] = "Edit Customer";
}

<h2>Edit Customer</h2>

<form method="post">
    <div class="form-group">
        <label asp-for="Customer.Givenname"></label>
        <input asp-for="Customer.Givenname" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="Customer.Surname"></label>
        <input asp-for="Customer.Surname" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="Customer.Emailaddress"></label>
        <input asp-for="Customer.Emailaddress" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="Customer.City"></label>
        <input asp-for="Customer.City" class="form-control" />
    </div>
    <button type="submit" class="btn btn-primary">Save Changes</button>
</form>
