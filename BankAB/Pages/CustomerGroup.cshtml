@page
@model BankAB.Pages.CustomerGroupModel
@{
    ViewData["Title"] = "Grouped Customers";
}

<section class="py-5" style="background-color: #f4f8fb;">
    <div class="container bg-white shadow-sm p-4 rounded">

        <h2 class="text-center mb-4">
            All Customers in <strong>@Model.GroupBy</strong>: <span class="text-primary">@Model.GroupValue</span>
        </h2>

        <!-- 🔍 Search -->
        <form method="get" class="mb-4 d-flex justify-content-center gap-2 flex-wrap">
            <input asp-for="Q" class="form-control w-50" placeholder="Search..." />
            <input type="hidden" asp-for="GroupBy" />
            <input type="hidden" asp-for="GroupValue" />
            <button type="submit" class="btn btn-primary">Search</button>
        </form>

        <!-- 📊 Table -->
        <div class="table-responsive">
            <table class="table table-striped text-center align-middle">
                <thead class="table-light">
                    <tr>
                        <th>
                            Given Name
                            <a asp-page="/CustomerGroup"
                               asp-route-q="@Model.Q"
                               asp-route-groupBy="@Model.GroupBy"
                               asp-route-groupValue="@Model.GroupValue"
                               asp-route-sortColumn="Givenname"
                               asp-route-sortOrder="asc">⬆️</a>
                            <a asp-page="/CustomerGroup"
                               asp-route-q="@Model.Q"
                               asp-route-groupBy="@Model.GroupBy"
                               asp-route-groupValue="@Model.GroupValue"
                               asp-route-sortColumn="Givenname"
                               asp-route-sortOrder="desc">⬇️</a>
                        </th>
                        <th>City</th>
                        <th>Country</th>
                        <th>Gender</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var cust in Model.PagedCustomers.Results)
                    {
                        <tr>
                            <td>@cust.Givenname</td>
                            <td>@cust.City</td>
                            <td>@cust.Country</td>
                            <td>@cust.Gender</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- 🔢 Pagination (Bootstrap v5 style) -->
        <nav aria-label="Customer pagination">
            <ul class="pagination justify-content-center mt-4">
                @if (Model.PagedCustomers.CurrentPage > 1)
                {
                    <li class="page-item">
                        <a class="page-link"
                           asp-page="/CustomerGroup"
                           asp-route-groupBy="@Model.GroupBy"
                           asp-route-groupValue="@Model.GroupValue"
                           asp-route-q="@Model.Q"
                           asp-route-pageNo="@(Model.PagedCustomers.CurrentPage - 1)"
                           asp-route-sortColumn="@Model.SortColumn"
                           asp-route-sortOrder="@Model.SortOrder">«</a>
                    </li>
                }

                @{
                    int startPage = Math.Max(1, Model.PagedCustomers.CurrentPage - 2);
                    int endPage = Math.Min(Model.PagedCustomers.PageCount, Model.PagedCustomers.CurrentPage + 2);
                }

                @for (int i = startPage; i <= endPage; i++)
                {
                    <li class="page-item @(i == Model.PagedCustomers.CurrentPage ? "active" : "")">
                        <a class="page-link"
                           asp-page="/CustomerGroup"
                           asp-route-groupBy="@Model.GroupBy"
                           asp-route-groupValue="@Model.GroupValue"
                           asp-route-q="@Model.Q"
                           asp-route-pageNo="@i"
                           asp-route-sortColumn="@Model.SortColumn"
                           asp-route-sortOrder="@Model.SortOrder">@i</a>
                    </li>
                }

                @if (Model.PagedCustomers.CurrentPage < Model.PagedCustomers.PageCount)
                {
                    <li class="page-item">
                        <a class="page-link"
                           asp-page="/CustomerGroup"
                           asp-route-groupBy="@Model.GroupBy"
                           asp-route-groupValue="@Model.GroupValue"
                           asp-route-q="@Model.Q"
                           asp-route-pageNo="@(Model.PagedCustomers.CurrentPage + 1)"
                           asp-route-sortColumn="@Model.SortColumn"
                           asp-route-sortOrder="@Model.SortOrder">»</a>
                    </li>
                }
            </ul>
        </nav>

        <!-- ⬅️ Back to Category -->
        <div class="text-center mt-4">
            <a asp-page="/Category"
               asp-route-groupBy="@Model.GroupBy"
               class="btn btn-outline-dark">
                ⬅️ Back to @Model.GroupBy Categories
            </a>
        </div>

    </div>
</section>
