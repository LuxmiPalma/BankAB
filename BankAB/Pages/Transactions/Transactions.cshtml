@page
@model BankAB.Pages.Transactions.TransactionsModel
@{
    ViewData["Title"] = "Transactions";
    var sortColumn = ViewContext.HttpContext.Request.Query["sortColumn"];
    var sortOrder = ViewContext.HttpContext.Request.Query["sortOrder"];

    Func<string, string> iconBaseClass = col => sortColumn == col ? "text-primary" : "text-muted";
    Func<string, string, string> activeIconClass = (col, order) =>
        sortColumn == col && sortOrder == order ? "fw-bold text-info" : "";
}

<div class="container mt-5">
    <div class="text-center mb-4">
        <h2>Transactions</h2>
        <h5>Total: @Model.Result.RowCount</h5>
        <a href="/" class="btn btn-secondary">← Return</a>
    </div>

    <form method="get" class="mb-3 d-flex justify-content-center">
        <input type="text" name="transactionId" class="form-control w-25 me-2" placeholder="Search Transaction ID" />
        <button class="btn btn-primary">Search</button>
    </form>

    <table class="table table-bordered text-center table-striped" id="transaction-table">
        <thead class="table-light">
            <tr>
                <th>
                    Transaction ID
                    <a asp-route-sortColumn="TransactionId" asp-route-sortOrder="asc" class="@iconBaseClass("TransactionId") @activeIconClass("TransactionId", "asc")">
                        <i class="fa-solid fa-angle-up"></i>
                    </a>
                    <a asp-route-sortColumn="TransactionId" asp-route-sortOrder="desc" class="@iconBaseClass("TransactionId") @activeIconClass("TransactionId", "desc")">
                        <i class="fa-solid fa-angle-down"></i>
                    </a>
                </th>
                <th>
                    Account ID
                    <a asp-route-sortColumn="AccountId" asp-route-sortOrder="asc" class="@iconBaseClass("AccountId") @activeIconClass("AccountId", "asc")">
                        <i class="fa-solid fa-angle-up"></i>
                    </a>
                    <a asp-route-sortColumn="AccountId" asp-route-sortOrder="desc" class="@iconBaseClass("AccountId") @activeIconClass("AccountId", "desc")">
                        <i class="fa-solid fa-angle-down"></i>
                    </a>
                </th>
                <th>
                    Customer ID
                    <a asp-route-sortColumn="CustomerId" asp-route-sortOrder="asc" class="@iconBaseClass("CustomerId") @activeIconClass("CustomerId", "asc")">
                        <i class="fa-solid fa-angle-up"></i>
                    </a>
                    <a asp-route-sortColumn="CustomerId" asp-route-sortOrder="desc" class="@iconBaseClass("CustomerId") @activeIconClass("CustomerId", "desc")">
                        <i class="fa-solid fa-angle-down"></i>
                    </a>
                </th>
                <th>
                    Date
                    <a asp-route-sortColumn="Date" asp-route-sortOrder="asc" class="@iconBaseClass("Date") @activeIconClass("Date", "asc")">
                        <i class="fa-solid fa-angle-up"></i>
                    </a>
                    <a asp-route-sortColumn="Date" asp-route-sortOrder="desc" class="@iconBaseClass("Date") @activeIconClass("Date", "desc")">
                        <i class="fa-solid fa-angle-down"></i>
                    </a>
                </th>
                <th>
                    Amount
                    <a asp-route-sortColumn="Amount" asp-route-sortOrder="asc" class="@iconBaseClass("Amount") @activeIconClass("Amount", "asc")">
                        <i class="fa-solid fa-angle-up"></i>
                    </a>
                    <a asp-route-sortColumn="Amount" asp-route-sortOrder="desc" class="@iconBaseClass("Amount") @activeIconClass("Amount", "desc")">
                        <i class="fa-solid fa-angle-down"></i>
                    </a>
                </th>
            </tr>
        </thead>
        <tbody>
            @foreach (var txn in Model.Result.Results)
            {
                <tr>
                    <td>
                        <a asp-page="/Transactions/TransactionDetails" asp-route-id="@txn.TransactionId" class="btn btn-outline-secondary">
                            <i class="bi bi-eye"></i> @txn.TransactionId
                        </a>
                    </td>
                    <td>
                        <a asp-page="/Accounts/Account" asp-route-id="@txn.AccountId" class="btn btn-outline-success">
                            @txn.AccountId
                        </a>
                    </td>

                    <td>
                        @if (txn.CustomerId != 0)
                        {
                            <a asp-page="/Customers/Customer" asp-route-id="@txn.CustomerId" class="btn btn-sm btn-primary">
                                @txn.CustomerId
                            </a>
                        }
                        else
                        {
                            <span class="text-muted">N/A</span>
                        }
                    </td>
                    <td>@txn.Date.ToString("yyyy-MM-dd")</td>
                    <td>SEK: @txn.Amount.ToString("N2", System.Globalization.CultureInfo.InvariantCulture)</td>
                </tr>
            }
        </tbody>
    </table>
    <!-- 🔢 Pagination -->
    <nav class="mt-4">
        <ul class="pagination justify-content-center">
            @if (Model.Result.CurrentPage > 1)
            {
                <li class="page-item">
                    <a class="page-link"
                       asp-page="/Transactions/Transactions"
                       asp-route-pageNo="@(Model.Result.CurrentPage - 1)"
                       asp-route-sortColumn="@sortColumn"
                       asp-route-sortOrder="@sortOrder">«</a>
                </li>
            }

            @for (int i = Math.Max(1, Model.Result.CurrentPage - 2); i <= Math.Min(Model.Result.PageCount, Model.Result.CurrentPage + 2); i++)
            {
                <li class="page-item @(i == Model.Result.CurrentPage ? "active" : "")">
                    <a class="page-link"
                       asp-page="/Transactions/Transactions"
                       asp-route-pageNo="@i"
                       asp-route-sortColumn="@sortColumn"
                       asp-route-sortOrder="@sortOrder">@i</a>
                </li>
            }

            @if (Model.Result.CurrentPage < Model.Result.PageCount)
            {
                <li class="page-item">
                    <a class="page-link"
                       asp-page="/Transactions/Transactions"
                       asp-route-pageNo="@(Model.Result.CurrentPage + 1)"
                       asp-route-sortColumn="@sortColumn"
                       asp-route-sortOrder="@sortOrder">»</a>
                </li>
            }
        </ul>
    </nav>
</div>


   
