@page "{accountId:int}"
@model BankAB.Pages.Transactions.TransferModel
@{
    ViewData["Title"] = "Transfer";
}

<div class="container mt-5">
    <div class="card shadow-lg rounded-4 p-4 mx-auto" style="max-width: 750px;">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h3 class="mb-0">Transfer Funds</h3>
            <a asp-page="/Accounts/Account" asp-route-id="@RouteData.Values["accountId"]" class="btn btn-outline-primary">
                Return
            </a>

        </div>
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success text-center mb-3">
                @TempData["SuccessMessage"]
            </div>
        }

        <form method="post">
            <div class="mb-3">
                <label asp-for="AccountId" class="form-label fw-semibold">From Account ID</label>
                <input asp-for="AccountId" class="form-control" readonly />
                <span asp-validation-for="AccountId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="TargetAccountId" class="form-label fw-semibold">To Account ID</label>
                <input asp-for="TargetAccountId" class="form-control" />
                <span asp-validation-for="TargetAccountId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Amount" class="form-label fw-semibold">Amount SEK:</label>
                <input asp-for="Amount" class="form-control" />
                <span asp-validation-for="Amount" class="text-danger"></span>
            </div>

            <div class="text-center">
                <button type="submit" class="btn btn-info text-white px-4">
                    <i class="bi bi-arrow-left-right me-1"></i> Transfer
                </button>
            </div>
        </form>

        <!-- From Account Table -->
        @if (Model.Account != null)
        {
            <div class="mt-4">
                <h5 class="fw-semibold">From Account</h5>
                <table class="table table-hover table-bordered shadow-sm rounded">
                    <thead class="table-light">
                        <tr>
                            <th>Account ID</th>
                            <th>Frequency</th>
                            <th>Created</th>
                            <th>Balance (SEK)</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>@Model.Account.AccountId</td>
                            <td>@Model.Account.Frequency</td>
                            <td>@Model.Account.Created</td>
                            <td>@Model.Account.Balance.ToString("N2")</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        }

        <!-- To Account Table -->
        @if (Model.TargetAccount != null)
        {
            <div class="mt-4">
                <h5 class="fw-semibold">To Account</h5>
                <table class="table table-hover table-bordered shadow-sm rounded">
                    <thead class="table-light">
                        <tr>
                            <th>Account ID</th>
                            <th>Frequency</th>
                            <th>Created</th>
                            <th>Balance (SEK)</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>@Model.TargetAccount.AccountId</td>
                            <td>@Model.TargetAccount.Frequency</td>
                            <td>@Model.TargetAccount.Created</td>
                            <td>@Model.TargetAccount.Balance.ToString("N2")</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
