@page
@model BankAB.Pages.Transactions.TransferModel
@{
    ViewData["Title"] = "Transfer";

}
<div class="container mt-5">
    <div class="card shadow-lg rounded-4 p-4 mx-auto" style="max-width: 650px;">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h3 class="mb-0"><i class="bi bi-arrow-left-right text-info me-2"></i> Transfer Funds</h3>
            <a asp-page="/Accounts/Account" asp-route-id="@RouteData.Values["accountId"]" class="btn btn-outline-primary">
                <i class="bi bi-arrow-left-circle"></i> Return
            </a>
        </div>

        <form method="post">
            <div class="mb-3">
                <label asp-for="TargetAccountId" class="form-label fw-semibold">Target Account ID</label>
                <input asp-for="TargetAccountId" class="form-control" />
                <span asp-validation-for="TargetAccountId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Amount" class="form-label fw-semibold">Amount</label>
                <input asp-for="Amount" class="form-control" />
                <span asp-validation-for="Amount" class="text-danger"></span>
            </div>

            

            <div class="text-center">
                <button type="submit" class="btn btn-info text-white px-4" title="Transfer money to another account">
                    <i class="bi bi-arrow-left-right me-1"></i> Transfer
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}