@page "{customerId:int}"
@model BankAB.Pages.Transactions.CustomerTransactionsModel

@{
    
}
<div class="container pt-5 mb-4 text-center">
    <h2 class="fw-bold mb-3">Transactions for Customer @Model.CustomerId</h2>
    <a asp-page="/Transactions/Transactions" asp-route-id="@Model.CustomerId" class="btn btn-info text-white mb-4">
        <i class="bi bi-arrow-left-circle"></i> Return
    </a>
</div>


    <table class="table table-bordered table-hover" id="transactions-table">
        <thead class="table-light">
            <tr>
                <th>Transaction Id</th>
                <th>Account Id</th>
                <th>Amount</th>
                <th>Date</th>
                <th>Operation</th>
            </tr>
        </thead>
        <tbody>
            @* Injected by JavaScript *@
        </tbody>
    </table>

    <div class="text-center mt-4">
        <button id="show-more-btn" class="btn btn-primary px-4 py-2">
            <i class="bi bi-plus-circle"></i> Show More
        </button>
    
</div>
<div style="height: 80px;"></div>

@section Scripts {
    <script>
        let pageNo = 1;
        const showMoreBtn = document.getElementById("show-more-btn");

        document.addEventListener("DOMContentLoaded", function () {
            showMore();
        });

        showMoreBtn.addEventListener("click", function () {
            showMore();
        });

        function showMore() {
            fetch(`?handler=ShowMore&pageNo=${pageNo}`)
                .then(response => response.json())
                .then(data => {
                    if (data.transactions.length === 0) {
                        showMoreBtn.disabled = true;
                        showMoreBtn.innerHTML = '<i class="bi bi-x-circle"></i> No More Transactions';
                        return;
                    }

                    pageNo++;
                    data.transactions.forEach(drawTransaction);
                })
                .catch(error => {
                    console.error("Error loading transactions:", error);
                    showMoreBtn.disabled = true;
                    showMoreBtn.innerHTML = '<i class="bi bi-exclamation-circle"></i> Error Loading';
                });
        }

        function drawTransaction(txn) {
            document.querySelector('#transactions-table tbody').innerHTML += `
                <tr>
                    <td>${txn.transactionId}</td>
                    <td>${txn.accountId}</td>
                    <td>SEK: ${txn.amount.toFixed(2)}</td>
                    <td>${new Date(txn.date).toLocaleDateString()}</td>
                    <td>${txn.operation}</td>
                </tr>
            `;
        }
    </script>
}
