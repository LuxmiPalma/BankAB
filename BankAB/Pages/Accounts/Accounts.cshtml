@page
@model BankAB.Pages.Accounts.AccountsModel
@{
    var q = ViewContext.HttpContext.Request.Query["q"];
}

    <div class="container my-5 d-flex justify-content-center">
        <div class="p-4 rounded-4 shadow-lg bg-white w-100" style="max-width: 1000px;">

            <h2 class="text-center mb-4">All Accounts</h2>

        <div class="d-flex justify-content-between align-items-center mb-3">
            <form method="get" class="d-flex">
                <input type="text" name="q" value="@q" class="form-control me-2" placeholder="Search name, city or country..." />
                <button class="btn btn-sm btn-primary hover-gray" type="submit">Search</button>
            </form>
           
        </div>

        <!-- 📊 Accounts Table -->
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>
                            ID
                            <a asp-page="/Accounts/Accounts" asp-route-q="@q" asp-route-sortColumn="Id" asp-route-sortOrder="asc"><i class="fa fa-angle-up"></i></a>
                            <a asp-page="/Accounts/Accounts" asp-route-q="@q" asp-route-sortColumn="Id" asp-route-sortOrder="desc"><i class="fa fa-angle-down"></i></a>
                        </th>
                        <th>
                            Frequency
                            <a asp-page="/Accounts/Accounts" asp-route-q="@q" asp-route-sortColumn="Frequency" asp-route-sortOrder="asc"><i class="fa fa-angle-up"></i></a>
                            <a asp-page="/Accounts/Accounts" asp-route-q="@q" asp-route-sortColumn="Frequency" asp-route-sortOrder="desc"><i class="fa fa-angle-down"></i></a>
                        </th>
                        <th>
                            Created
                            <a asp-page="/Accounts/Accounts" asp-route-q="@q" asp-route-sortColumn="Created" asp-route-sortOrder="asc"><i class="fa fa-angle-up"></i></a>
                            <a asp-page="/Accounts/Accounts" asp-route-q="@q" asp-route-sortColumn="Created" asp-route-sortOrder="desc"><i class="fa fa-angle-down"></i></a>
                        </th>
                        <th class="text-center">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var acc in Model.PagedAccounts.Results)
                    {
                        <tr>
                            <td>@acc.Id</td>
                            <td>@acc.Frequency</td>
                            <td>@acc.Created.ToString("yyyy-MM-dd")</td>
                            <td class="text-center">
                                <a asp-page="/Accounts/Account" asp-route-id="@acc.Id" class="btn btn-sm btn-outline-primary">
                                    <i class="fa fa-eye me-1"></i> View
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <!-- 🔢 Pagination -->
        <nav class="mt-4">
            <ul class="pagination justify-content-center">
                @if (Model.PagedAccounts.CurrentPage > 1)
                {
                    <li class="page-item">
                        <a class="page-link"
                           asp-page="/Accounts/Accounts"
                           asp-route-pageNo="@(Model.PagedAccounts.CurrentPage - 1)"
                           asp-route-sortColumn="@Model.SortColumn"
                           asp-route-sortOrder="@Model.SortOrder"
                           asp-route-q="@Model.Q">«</a>
                    </li>
                }

                @for (int i = Math.Max(1, Model.PagedAccounts.CurrentPage - 2); i <= Math.Min(Model.PagedAccounts.PageCount, Model.PagedAccounts.CurrentPage + 2); i++)
                {
                    <li class="page-item @(i == Model.PagedAccounts.CurrentPage ? "active" : "")">
                        <a class="page-link"
                           asp-page="/Accounts/Accounts"
                           asp-route-pageNo="@i"
                           asp-route-sortColumn="@Model.SortColumn"
                           asp-route-sortOrder="@Model.SortOrder"
                           asp-route-q="@Model.Q">@i</a>
                    </li>
                }

                @if (Model.PagedAccounts.CurrentPage < Model.PagedAccounts.PageCount)
                {
                    <li class="page-item">
                        <a class="page-link"
                           asp-page="/Accounts/Accounts"
                           asp-route-pageNo="@(Model.PagedAccounts.CurrentPage + 1)"
                           asp-route-sortColumn="@Model.SortColumn"
                           asp-route-sortOrder="@Model.SortOrder"
                           asp-route-q="@Model.Q">»</a>
                    </li>
                }
            </ul>
        </nav>
    </div>
</div>
   
