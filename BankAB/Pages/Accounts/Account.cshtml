@page "{id:int}"
@model BankAB.Pages.Accounts.AccountModel
@{
    ViewData["Title"] = "Account Details";
}

<div class="container mt-5">
    @* <h2 >Account Details</h2>
    <a asp-page="/Accounts/Accounts" class="btn btn-secondary">← Return</a> *@
    <div class="container pt-5 mt-6 text-center">
        <h2 class="mb-3 fw-bold">Account Details</h2>
        <a asp-page="/Accounts/Accounts" class="btn btn-outline-primary">
            <i class="" btn btn-secondary""></i> Return 
        </a>
    </div>

    <table class="table mt-3 table-bordered">
        <thead>
            <tr>
                <th>Account ID</th>
                <th>Frequency</th>
                <th>Created</th>
                <th>Balance</th>
                <th>Customers</th>
                <th>Transactions</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>@Model.Account.AccountId</td>
                <td>@Model.Account.Frequency</td>
                <td>@Model.Account.Created</td>
                <td>@Model.Account.Balance.ToString("N2") SEK</td>
                <td>
                    @foreach (var d in Model.Account.Dispositions)
                    {
                        <div>
                            <a class="text-primary">
                                <i class="bi bi-eye"></i> @d.Customer.Givenname @d.Customer.Surname (@d.Type)
                            </a>
                        </div>

                    }
                </td>
                <td>
                    @foreach (var d in Model.Account.Dispositions)
                    {
                        <div>
                            <a asp-page="/Transactions/CustomerTransactions" asp-route-customerId="@d.Customer.CustomerId" class="btn btn-outline-primary btn-sm">
                                <i class="bi bi-eye"></i> View @d.Customer.Givenname's Transactions
                            </a>
                        </div>
                    }
                </td>
                <td>
                    <a asp-page="/Transactions/Deposit" asp-route-accountId="@Model.Account.AccountId" class="btn btn-success"><i class="bi bi-plus"></i></a>
                    <a asp-page="/Transactions/Withdraw" asp-route-accountId="@Model.Account.AccountId" class="btn btn-warning"><i class="bi bi-dash-circle"></i></a>
                    <a asp-page="/Transactions/Transfer" asp-route-accountId="@Model.Account.AccountId" class="btn btn-warning"><i class="bi bi-arrow-left-right"></i></a>
                    <button class="btn btn-danger">Delete</button>
                </td>
            </tr>
        </tbody>
    </table>
</div>
