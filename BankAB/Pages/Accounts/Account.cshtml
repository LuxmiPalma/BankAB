@page
@model BankAB.Pages.Accounts.AccountModel
@{
}
<h2>Account </h2>

<p><strong>Id:</strong> @Model.Id</p>
<p><strong>Balance:</strong> @Model.Balance</p>

<a asp-page="/Accounts/Accounts" class="btn btn-secondary">Back to List</a>

<a asp-page="Accounts/Deposit" asp-route-accountId="@Model.Id" class="btn btn-success btn-sm">Deposit</a>
<a asp-page="Accounts/Withdraw" asp-route-accountId="@Model.Id" class="btn btn-danger btn-sm">Withdraw</a>


