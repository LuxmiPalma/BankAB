@page "{id:int}"
@model BankAB.Pages.Accounts.AccountModel
@{
    ViewData["Title"] = "Account Details";
}

<div class="container mt-5">
    @* <h2 >Account Details</h2>
    <a asp-page="/Accounts/Accounts" class="btn btn-secondary"> Return</a> *@
    <div class="container pt-5 mt-6 text-center">
        <h2 style="font-size: 2.5rem; font-weight: 700;" class="mb-3 fw-bold">Account Details</h2>

            <a asp-page="/Accounts/Accounts" class="btn btn-primary btn-lg">
                <i class="bi bi-arrow-left"></i > Return
            </a>
        
    </div>

    <partial name="Partials/_AccountDetails" model="Model.Account" />

</div>
<div class="alert alert-danger text-center fs-5 mt-4 fw-semibold shadow-sm border border-danger-subtle">
    <div class="fs-4 fw-bold mb-1 text-danger">⚠️ Account Removal / Delete Information</div>
    <div>Customers must have at least one account</div>
</div>

