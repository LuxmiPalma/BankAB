@page
@model BankAB.Pages.AccountsModel
@{
}

<h1>All Accounts</h1>

<table class="table table-striped">
    <thead>
        <tr>
            <th scope="col">Id</th>
            <th scope="col">Frequency</th>
            <th scope="col">Created</th>
            <th scope="col">Balance</th>
            <th></th>
        </tr>
    </thead>
    <tbody>

        @foreach (var acc in Model.Accounts)
        {
            <tr>
                <td>@acc.Id</td>
                <td>@acc.Frequency</td>
                <td>@acc.Created</td>
                <td>@acc.Balance</td>
                <td><a asp-page="/Accounts" asp-route-id="@acc.Id" class="btn btn-primary">View</a></td>
            </tr>
        }
    </tbody>
</table>