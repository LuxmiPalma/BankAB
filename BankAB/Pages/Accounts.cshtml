@page
@model BankAB.Pages.AccountsModel
@{
}

<h1>All Accounts</h1>

<table class="table table-striped">
    <thead>
        <tr>
            <th scope="col">Id</th>
            <th scope="col">Frequency</th>
            <th scope="col">
                Account Created 
                <a asp-page="/Accounts"
                   asp-route-sortColumn="Created"
                   asp-route-sortOrder="asc"
                   style="text-decoration:none">
                    <i class="fa-solid fa-angle-up"></i>

                </a>
                <a asp-page="/Accounts"
                   asp-route-sortColumn="Created"
                   asp-route-sortOrder="desc"
                   style="text-decoration:none">
                    <i class="fa-solid fa-angle-down"></i>
                </a>
            </th>
            <th scope="col">
                Account Balance
                <a asp-page="/Accounts"
                   asp-route-sortColumn="Balance"
                   asp-route-sortOrder="asc"
                   style="text-decoration:none">
                    <i class="fa-solid fa-angle-up"></i>

                </a>
                <a asp-page="/Accounts"
                   asp-route-sortColumn="Balance"
                   asp-route-sortOrder="desc"
                   style="text-decoration:none">
                    <i class="fa-solid fa-angle-down"></i>
                </a>
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>

        @foreach (var acc in Model.Accounts)
        {
            <tr>
                <td>@acc.Id</td>
                <td>@acc.Frequency</td>
                <td>@acc.Created</td>
                <td>@acc.Balance</td>
                <td><a asp-page="/Accounts" asp-route-id="@acc.Id" class="btn btn-primary">View</a></td>
            </tr>
        }
    </tbody>
</table>