@model BankAB.ViewComponents.WeatherModel

<a class="nav-link">
    @if (double.TryParse(Model.Temperature, out var temp))
    {
        if (temp > 30)
        {
            <i class="fas fa-sun"></i>
        }
        else if (temp > 20)
        {
            <i class="fas fa-cloud-sun"></i>
        }
        else
        {
            <i class="fas fa-cloud"></i>
        }
    }
    @Model.Location @Model.Temperature&#8451;
</a>